#!/bin/sh
set -eu
case "$(cat /tmp/sysinfo/board_name)" in
 dlink,dpn-be7200gr|dlink,dpn-be7200gr-ram) ;;
 *) exit 1;;
esac
test -f /sys/bus/nvmem/devices/dpn-art/nvmem
test ! -d /sys/module/mt7996e
for d in 0000:01:00.0 0001:01:00.0; do
    test ! -L /sys/bus/pci/devices/$d/driver
    test "$(cat /sys/bus/pci/devices/$d/vendor)" = 0x14c3
done
test "$(cat /sys/bus/pci/devices/0000:01:00.0/device)" = 0x799a
test "$(cat /sys/bus/pci/devices/0001:01:00.0/device)" = 0x7992
base=
for c in /sys/class/gpio/gpiochip*; do
    test "$(cat "$c/label")" = 1fbf0200.system-controller:pinctrl || continue
    test -z "$base"
    test "$(cat "$c/ngpio")" = 64
    base=$(cat "$c/base")
done
test -n "$base"
gpio=$((base + 8)); g=/sys/class/gpio/gpio$gpio
test ! -e "$g"
owned=0
cleanup() {
    if [ "$owned" = 1 ]; then
        echo in > "$g/direction"
        echo "$gpio" > /sys/class/gpio/unexport
    fi
}
trap cleanup EXIT HUP INT TERM
echo 1 > /sys/bus/pci/devices/0001:01:00.0/remove
echo 1 > /sys/bus/pci/devices/0000:01:00.0/remove
echo "$gpio" > /sys/class/gpio/export
owned=1
echo low > "$g/direction"
sleep 1
echo in > "$g/direction"
test "$(cat "$g/value")" = 1
cleanup; owned=0
sleep 2
echo 1 > /sys/bus/pci/rescan
sleep 1
for d in 0000:01:00.0 0001:01:00.0; do
    test -f /sys/bus/pci/devices/$d/vendor
done
modprobe mt7996e
for n in 1 2 3 4 5; do
    test -d /sys/class/ieee80211/phy0 && break
    sleep 1
done
test -d /sys/class/ieee80211/phy0
echo "GPIO=$gpio; PHY_READY; regulatory domain remains owner-configured"
echo READY > /tmp/dpn-wifi-auto.ready
