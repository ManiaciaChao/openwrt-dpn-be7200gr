#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=89
USE_PROCD=1
start_service() {
 [ -f /etc/dpn-network-recovery ] || return 1
 [ -s /etc/dropbear/authorized_keys ] || return 1
 [ -s /etc/dropbear/dropbear_ed25519_host_key ] || return 1
 cp /etc/dpn-network-recovery /tmp/dpn-network-recovery || return 1
 procd_open_instance
 procd_set_param command /usr/sbin/dropbear -F -E -s -g -p 22 -r /etc/dropbear/dropbear_ed25519_host_key -P /tmp/dpn-recovery-dropbear.pid
 procd_set_param respawn
 procd_close_instance
}
