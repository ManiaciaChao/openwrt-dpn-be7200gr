#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=98
USE_PROCD=1
start_service() {
 [ -f /etc/dpn-factory-auto ] && [ -f /etc/dpn-factory-installer ] || return 0
 # No respawn: an interrupted write must never be retried by the service manager.
 procd_open_instance
 procd_set_param command /bin/sh -c 'exec /usr/libexec/dpn-factory-auto > /tmp/dpn-factory-auto.log 2>&1'
 procd_set_param stdout 0
 procd_set_param stderr 0
 procd_close_instance
}
