 #include <linux/spi/spi-mem.h>
 #include <linux/mtd/mtk_bmt.h>
+#include <linux/mtd/dpn_persist_guard.h>
 
 /* Laboratory policy: physical NAND reads only, independent of DT partitions. */
 static bool dpn_nand_readonly(void)
 {
 	return of_machine_is_compatible("dlink,dpn-be7200gr-ram");
+}
+
+static bool dpn_persistent(void)
+{
+	return of_machine_is_compatible("dlink,dpn-be7200gr-persist");
 }
 
