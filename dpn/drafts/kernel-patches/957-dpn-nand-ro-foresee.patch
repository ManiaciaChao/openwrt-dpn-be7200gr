+static int f35sqb004g_ooblayout_ecc(struct mtd_info *mtd, int section,
+				 struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+	region->offset = 128;
+	region->length = 128;
+	return 0;
+}
+
+static int f35sqb004g_ooblayout_free(struct mtd_info *mtd, int section,
+				  struct mtd_oob_region *region)
+{
+	if (section)
+		return -ERANGE;
+	region->offset = 2;
+	region->length = 126;
+	return 0;
+}
+
+static const struct mtd_ooblayout_ops f35sqb004g_ooblayout = {
+	.ecc = f35sqb004g_ooblayout_ecc,
+	.free = f35sqb004g_ooblayout_free,
+};
+
+static int f35sqb004g_ecc_get_status(struct spinand_device *spinand, u8 status)
+{
+	u8 ecc = (status >> 4) & 7;
+
+	if (ecc == 7)
+		return -EBADMSG;
+	return ecc == 0 ? 0 : ecc == 1 ? 3 : ecc + 2;
+}
